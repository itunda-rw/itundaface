{
  "name": "ItundaFace",
  "version": "2.0.0",
  "brand": {
    "indigo": {
      "light": "#7472F4",
      "dark": "#7675F8"
    }
  },
  "semantic": {
    "face": "#FFCC4D",
    "faceShadow": "#D98E0A",
    "ink": "#664500",
    "inkSoft": "#66471B",
    "skin": "#FFCF87",
    "skinShadow": "#E0A655",
    "heart": "#EF4A63",
    "heartDeep": "#C72E4C"
  },
  "flat": {
    "viewBox": "0 0 80 80",
    "minimumReadableSize": 14,
    "preferredSizes": [14, 16, 18, 20, 24]
  },
  "threeD": {
    "preferredSizes": [32, 40, 48, 64],
    "lightDirection": "top-left",
    "shadowDirection": "down",
    "shadowOpacity": 0.28,
    "rimOpacity": 0.85
  },
  "construction": {
    "cornerLanguage": "soft-organic",
    "strokeCap": "round",
    "strokeJoin": "round",
    "brandAccentRule": "identity-first, semantic-color-first",
    "flat3dSilhouetteMustMatch": true
  }
}
