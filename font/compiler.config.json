{
  "format": "itundaface-color-font-compiler-config-v1",
  "sourceManifest": "./build-manifest.json",
  "target": "COLR/CPAL",
  "version": 1,
  "unitsPerEm": 1000,
  "glyphCanvas": {"width": 80, "height": 80},
  "coordinatePolicy": {
    "sourceOrigin": "top-left",
    "fontOrigin": "baseline",
    "scale": 12.5,
    "baseline": 750
  },
  "layers": {
    "flatAsset": "source",
    "threeDAsset": "source"
  },
  "output": {
    "fontFamily": "ItundaFace",
    "file": "dist/ItundaFace-COLR.ttf",
    "format": "truetype"
  },
  "unicodePolicy": "private-use-distribution-only",
  "sourceOfTruth": "SVG masters"
}
